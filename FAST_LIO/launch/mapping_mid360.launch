<launch>
<!-- Launch file for Livox MID360 LiDAR -->

	<arg name="rviz" default="false" />

	<rosparam command="load" file="$(find fast_lio)/config/mid360.yaml" />

        <remap from="/Odometry" to="/mavros/odometry/out" />
        <remap from="/LidarPose" to="/mavros/vision_pose/pose" />
        <remap from="/cloud_registered" to="/ego_planner_node/grid_map/cloud" />
grid_map/cloud

	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="3"/>
	<param name="max_iteration" type="int" value="3" />
	<param name="filter_size_surf" type="double" value="0.4" />
	<param name="filter_size_map" type="double" value="0.4" />
	<param name="cube_side_length" type="double" value="1000" />
	<param name="runtime_pos_log_enable" type="bool" value="0" />
	
	<param name="adaptive_filter_scale" type="double" value="-0.1" />
	<param name="mapping/search_distance" type="double" value="10.0" />
	<param name="mapping/max_points" type="int" value="500000" />

	<param name="relocalization/enable" type="bool" value="false" />
	<param name="relocalization/pcd_path" type="string" value="/home/orangepi/chen_ws/src/FAST_LIO/PCD/1781164583.784059_scans.pcd" />
	<param name="relocalization/accumulate_frames" type="int" value="10" />
	<param name="relocalization/icp_max_iteration" type="int" value="100" />
	<param name="relocalization/ndt_resolution" type="double" value="1.0" />
	<param name="relocalization/ndt_step_size" type="double" value="0.1" />
	<param name="relocalization/ndt_epsilon" type="double" value="0.002" />
	<param name="relocalization/score_threshold" type="double" value="1.0" />

    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" /> 

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
	</group>

</launch>
