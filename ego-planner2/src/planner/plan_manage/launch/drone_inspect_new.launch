<launch>
     
<!-- //    <node pkg="ego_planner" type="rosip.sh" -->
<!-- //    name="rosip" output="screen"> -->
<!-- //    </node> -->

    <arg name="map_size_x" default="200.0"/>
    <arg name="map_size_y" default="200.0"/>
    <arg name="map_size_z" default="10.0"/>
    <arg name="odom_topic" default="/mavros/local_position/odom" />

    <arg name="drone_id" default="0"/>

    <arg name="init_x" default="0.0"/>
    <arg name="init_y" default="0.0"/>
    <arg name="init_z" default="0.0"/>

    <arg name="flight_type" default="2"/>
    <arg name="watch_waypoint" default="false"/>
    
    <rosparam file="/home/orangepi/chen_ws/src/rviz_draw/waypoints.yaml" command="load" />
        
    <arg name="max_vel" default="1.0"/>
    <arg name="waypoint_dim" default="6"/>
    <arg name="target0_x" default="9.0"/>
    <arg name="target0_y" default="9.0"/>
    <arg name="target0_z" default="1.0"/>
    <arg name="target1_x" default="9.0"/>
    <arg name="target1_y" default="-9.0"/>
    <arg name="target1_z" default="1.0"/>
    <arg name="target2_x" default="-9.0"/>
    <arg name="target2_y" default="-9.0"/>
    <arg name="target2_z" default="1.0"/>
    <arg name="target3_x" default="-9.0"/>
    <arg name="target3_y" default="9.0"/>
    <arg name="target3_z" default="1.0"/>
    <arg name="target4_x" default="0.0"/>
    <arg name="target4_y" default="0.0"/>
    <arg name="target4_z" default="1.0"/>

    
    <include file="$(find ego_planner)/launch/advanced_param_inspect_lidar.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <!-- camera pose: transform of camera frame in the world frame -->
        <!-- depth topic: depth image, 640x480 by default -->
        <!-- don't set cloud_topic if you already set these ones!  -->
        <!--
        <arg name="camera_pose_topic" value="/vins_estimator/camera_pose"/>
        <arg name="depth_topic" value="/visbot_itof/depth"/>
        <arg name="depth_info_topic" value="/visbot_itof/depth_info"/>
        <arg name="depth_extrinsic_topic" value="/visbot_itof/extrinsic"/>
        -->

        <!-- don't set camera pose and depth, if you already set this one! -->
        <arg name="cloud_topic" value="/ego_planner_node/grid_map/cloud"/>

        <!-- intrinsic params of the depth camera -->
        <arg name="cx" value="320.0"/>
        <arg name="cy" value="240.0"/>
        <arg name="fx" value="350.0"/>
        <arg name="fy" value="350.0"/>

        <arg name="skip_pixel" value="2"/>
        <arg name="fading_time" value="-1.0"/>

        <!-- maximum velocity, acceleration and jerk the drone will reach -->
        <arg name="max_vel" value="$(arg max_vel)" />
        <arg name="max_acc" value="5.0" />
        <arg name="max_jer" value="10.0" />
        <!--always set to 1.5 times grater than sensing horizen, important!!!-->
        <arg name="planning_horizon" value="10.0" />
        <arg name="use_multitopology_trajs" value="false" />
        <!-- 1: use 2D Nav Goal to select goal  -->
        <!-- 2: use global waypoints below  -->
        <arg name="flight_type" value="$(arg flight_type)" />
        <!-- global waypoints -->
        <!-- It generates a piecewise min-snap traj passing all waypoints -->
        <!--arg name="point_num" value="$(arg point_num)" /-->
        <arg name="waypoint_dim" value="$(arg waypoint_dim)" />
        <arg name="watch_waypoint" value="$(arg watch_waypoint)" />
        
        <arg name="point0_x" value="$(arg target0_x)" />
        <arg name="point0_y" value="$(arg target0_y)" />
        <arg name="point0_z" value="$(arg target0_z)" />
        <arg name="point1_x" value="$(arg target1_x)" />
        <arg name="point1_y" value="$(arg target1_y)" />
        <arg name="point1_z" value="$(arg target1_z)" />
        <arg name="point2_x" value="$(arg target2_x)" />
        <arg name="point2_y" value="$(arg target2_y)" />
        <arg name="point2_z" value="$(arg target2_z)" />
        <arg name="point3_x" value="$(arg target3_x)" />
        <arg name="point3_y" value="$(arg target3_y)" />
        <arg name="point3_z" value="$(arg target3_z)" />
        <arg name="point4_x" value="$(arg target4_x)" />
        <arg name="point4_y" value="$(arg target4_y)" />
        <arg name="point4_z" value="$(arg target4_z)" />
    </include>

    <!-- trajectory server -->
    <node pkg="ego_planner" name="traj_server" type="traj_server" output="screen">
        <param name="traj_server/time_forward" value="2.0" type="double"/>
        <remap from="~heartbeat" to="/traj_server/heartbeat"/>
        <remap from="~pause" to="/traj_server_pause"/>
        <remap from="~odom" to="/ekf/ekf_odom"/>
        <remap from="~planning/cmd" to="/planning/cmd"/>
        <remap from="~planning/trajectory" to="/planning/trajectory"/>
        <remap from="~reference/flatsetpoint" to="/reference/flatsetpoint"/>

    </node>

    <!--node pkg="image_recorder" name="image_saver_node" type="image_saver_node.py" output="screen">
    <param name="image_topic" value="/visbot_media_g/gimbal_camera/image_raw" />
    <param name="shutter_topic" value="/camera_shutter" />
    <param name="odom_topic" value="$(arg odom_topic)" />
    <param name="save_interval" value="0.5" />
    <param name="save_dir" value="/media/udisk/my_images" />
    <<param name="save_dir" value="$(env HOME)/my_images" />>
     </node-->

</launch>


